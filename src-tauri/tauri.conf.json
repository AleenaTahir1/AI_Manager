{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Task Manager",
  "version": "0.2.1",
  "identifier": "com.razee4315.aitaskmanager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Task Manager",
        "label": "main",
        "width": 1024,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "shadow": true,
        "center": true
      },
      {
        "title": "System Monitor",
        "label": "system_monitor",
        "url": "/?window=monitor",
        "width": 260,
        "height": 40,
        "minWidth": 200,
        "minHeight": 32,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://openrouter.ai https://api.openrouter.ai https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com http://localhost:11434 http://localhost:1234"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A faster, smarter Windows Task Manager.",
    "longDescription": "AI Task Manager replaces Windows Task Manager with a faster UI, deeper process insight, and AI-powered explanations for what is running and why."
  }
}
